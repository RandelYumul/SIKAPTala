[sub_resource type="GDScript" id="GDScript_bfcjb"]
script/source = "extends Node2D

@export var arrow_textures: Dictionary = {
	\"UP\": preload(\"res://assets/pixel_art/pixel_folder/ArrowUp.png\"),
	\"DOWN\": preload(\"res://assets/pixel_art/pixel_folder/ArrowDown.png\"),
	\"LEFT\": preload(\"res://assets/pixel_art/pixel_folder/ArrowLeft.png\"),
	\"RIGHT\": preload(\"res://assets/pixel_art/pixel_folder/ArrowRight.png\")
}

@export var interval: float = 1.5
@export var score_needed: int = 7

var expected := \"\"
var score := 0
var total := 0

func _ready() -> void:
	_show_new_arrow()
	var timer := Timer.new()
	timer.wait_time = interval
	timer.autostart = true
	timer.one_shot = false
	add_child(timer)
	timer.connect(\"timeout\", Callable(self, \"_on_timer_timeout\"))

func _show_new_arrow() -> void:
	var options = [\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"]
	expected = options[randi() % options.size()]
	$PromptArrow.texture = arrow_textures[expected]
	$InputArrow.texture = null  # clear previous input

func _on_timer_timeout() -> void:
	total += 1
	_show_new_arrow()
	if total >= 10:
		_end_round()

func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"ui_up\"):
		$InputArrow.texture = arrow_textures[\"UP\"]
		if expected == \"UP\": score += 1
	elif Input.is_action_just_pressed(\"ui_down\"):
		$InputArrow.texture = arrow_textures[\"DOWN\"]
		if expected == \"DOWN\": score += 1
	elif Input.is_action_just_pressed(\"ui_left\"):
		$InputArrow.texture = arrow_textures[\"LEFT\"]
		if expected == \"LEFT\": score += 1
	elif Input.is_action_just_pressed(\"ui_right\"):
		$InputArrow.texture = arrow_textures[\"RIGHT\"]
		if expected == \"RIGHT\": score += 1

func _end_round() -> void:
	if score >= score_needed:
		get_tree().change_scene_to_file(\"res://Levels/SuccessBathroom.tscn\")
	else:
		get_tree().change_scene_to_file(\"res://Levels/FailureBathroom.tscn\")
"

